# ============================================================
# STAGING environment — /opt/christian-listings/.env.staging
# Same variable names as prod's .env; values point at staging
# resources so nothing here can touch production quota or real
# users. Fill in every <TODO: ...> before first deploy.
# ============================================================

# --- Database: the SAME Atlas cluster (Cluster0) and connection string
# as prod's .env — copy MONGO_URI verbatim from there. Isolation from
# prod comes from MONGO_DB_SUFFIX below, not a separate cluster: staging
# deliberately has NO suffix, so it keeps using the same cl_identity,
# cl_events, etc. databases that were already live before the
# christianlistings.com cutover. Prod now runs with MONGO_DB_SUFFIX=_prod
# (hardcoded in docker-compose.prod.yml) against fresh, empty databases —
# so there is no way for staging and prod to collide even on one cluster.
MONGO_URI=<TODO: copy the exact value from /opt/christian-listings/.env>
# Leave unset/blank here — do not set to _prod.
MONGO_DB_SUFFIX=

# --- Firebase Admin SDK: same Firebase PROJECT as prod is fine (Auth
# users are shared across environments), OR point at a separate
# Firebase project if you want fully isolated auth/test accounts too.
FIREBASE_SERVICE_ACCOUNT_JSON=<TODO: same value as prod .env, or a staging service account>

# --- Internal service-to-service auth: MUST be different from prod's
# INTERNAL_SERVICE_KEY so a staging container can never authenticate
# against a prod one (or vice versa) if URLs are ever mixed up.
INTERNAL_SERVICE_KEY=<TODO: generate 32+ random bytes, distinct from prod>

# --- Public URLs: point at the staging Firebase Hosting sites once
# they exist (task: "Add staging Firebase Hosting sites").
APP_URL=https://christian-listings-stage.web.app
PUBLIC_APP_URL=https://christian-listings-stage.web.app

# --- Media/Cloudinary: reuse prod's Cloudinary account (media assets
# aren't sensitive), but consider a "staging/" folder prefix if you
# want to keep test uploads visually separate in the Cloudinary console.
CLOUDINARY_CLOUD_NAME=<TODO: same as prod, or a separate free account>
CLOUDINARY_API_KEY=<TODO>
CLOUDINARY_API_SECRET=<TODO>
CL_MEDIA_ALLOWED_ORIGINS=https://christian-listings-stage.web.app,https://christian-listings-stage.firebaseapp.com,https://christian-listings-admin-stage.web.app,https://christian-listings-admin-stage.firebaseapp.com

# --- Admin subgraph CORS + rate limit
ADMIN_ALLOWED_ORIGINS=https://christian-listings-admin-stage.web.app,https://christian-listings-admin-stage.firebaseapp.com
ADMIN_RATE_LIMIT_PER_MINUTE=120
APP_VERSION=staging
APP_SECRET=<TODO: distinct from prod>

# --- Email: OFF by default in staging so testing never sends real
# email to real inboxes. Flip EMAIL_ENABLED=true only if you specifically
# need to test the email pipeline. EMAIL_PROVIDER selects which block
# below is actually used — 'sendgrid' or 'ses'. Migration in progress:
# SendGrid stays wired until SES is validated end-to-end in staging.
EMAIL_ENABLED=false
EMAIL_PROVIDER=sendgrid

# SendGrid (used when EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=<TODO: only needed if EMAIL_ENABLED=true>
SENDGRID_FROM_EMAIL=notifications@christianlistings.com
SENDGRID_FROM_NAME=Christian Listings (Staging)
SENDGRID_REPLY_TO=support@christianlistings.com
SENDGRID_WEBHOOK_PUBLIC_KEY=<TODO: only needed if EMAIL_ENABLED=true>

# AWS SES (used when EMAIL_PROVIDER=ses) — needs Phase 0's AWS setup
# done first: verified sending domain, SNS topic, SQS queue subscribed
# to it, SES configuration set pointed at the topic, and a dedicated
# least-privilege IAM user. See the SES migration plan for the exact
# IAM policy. Leave every value below as <TODO> until that's done —
# nothing reads these unless EMAIL_PROVIDER is switched to ses.
AWS_REGION=<TODO: e.g. eu-west-1>
AWS_ACCESS_KEY_ID=<TODO: dedicated IAM user, not root/admin credentials>
AWS_SECRET_ACCESS_KEY=<TODO>
SES_FROM_EMAIL=<TODO: must be on the SES-verified domain>
SES_FROM_NAME=Christian Listings (Staging)
SES_REPLY_TO=support@christianlistings.com
SES_CONFIGURATION_SET=<TODO: the config set with the SNS event destination>
SQS_EVENT_QUEUE_URL=<TODO: full https://sqs.<region>.amazonaws.com/... URL>

# --- AI content risk: OFF by default so staging testing never burns
# your Gemini quota. Use a separate low-quota key if you turn it on.
AI_RISK_ENABLED=false
AI_RISK_PROVIDER=gemini
GEMINI_API_KEY=<TODO: only needed if AI_RISK_ENABLED=true>
GEMINI_MODEL=gemini-2.5-flash
