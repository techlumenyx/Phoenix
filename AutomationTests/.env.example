# Target environments
PUBLIC_URL=https://christianlistings.com/
ADMIN_URL=https://christian-listings-admin.firebaseapp.com/

# Use a dedicated, least-privilege automation account in CI.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=change-me

# Organisation account created by the end-to-end test. The {timestamp}
# placeholder makes the Firebase email and organisation name unique per run.
ORG_EMAIL_TEMPLATE=automation+{timestamp}@example.com
ORG_PASSWORD=change-me-123
ORG_PHONE=+441234567890
ORG_NAME_PREFIX=Automation Organisation

# Optional comma-separated admin sidebar labels.
ADMIN_SECTIONS=Overview,Moderation,AI risk signals,Verifications,Users,Organisations,Content,Analytics,Audit log,Templates,Email delivery,Highlights,System health

# Timing controls
NAVIGATION_TIMEOUT_MS=30000
ELEMENT_TIMEOUT_MS=10000
AUTH_WAIT_MS=30000
PREVIEW_WAIT_MS=0
